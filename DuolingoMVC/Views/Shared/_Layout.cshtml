@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Duolingo Academy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-p1CmX6m9YdQmQjvZ1N2q3Kz9V6g1QeX2q2Xo6nJgqG1V7Jq1Zc1w5J6k9GvQ1Yz1Q6v1l6Q==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DuolingoMVC.styles.css" asp-append-version="true" />
</head>
<body>
    @{ var isLoggedIn = Context.Session.GetInt32("UserProfileId") != null; }
    <aside class="duo-sidebar">
        <div class="duo-brand">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <span class="duo-logo">duo</span>
                <span class="duo-title">Duolingo Academy</span>
            </a>
        </div>
        <nav class="duo-nav">
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link"><i class="fa-solid fa-house"></i><span>Aprender</span></a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Lessons" class="nav-link"><i class="fa-solid fa-book"></i><span>Lecciones</span></a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Chat" class="nav-link"><i class="fa-solid fa-comments"></i><span>Chat</span></a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Profile" class="nav-link"><i class="fa-solid fa-user"></i><span>Perfil</span></a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Privacy" class="nav-link"><i class="fa-solid fa-shield-halved"></i><span>Privacidad</span></a></li>
            </ul>
        </nav>
        <div class="duo-actions">
            @if (isLoggedIn)
            {
                <a class="btn btn-ghost" asp-area="" asp-controller="Home" asp-action="Logout">Cerrar sesión</a>
            }
            else
            {
                <a class="btn btn-ghost" asp-area="" asp-controller="Home" asp-action="Login">Iniciar sesión</a>
                <a class="btn btn-primary duo-cta" asp-area="" asp-controller="Home" asp-action="Register">Crear cuenta</a>
            }
        </div>
    </aside>

    <div class="site-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-section">
        <div class="container text-center">
            &copy; 2026 Duolingo Academy
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
