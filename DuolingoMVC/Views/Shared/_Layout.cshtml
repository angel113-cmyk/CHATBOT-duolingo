@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Duolingo Academy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DuolingoMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-light px-4">
            <a class="navbar-brand fw-bold text-success" asp-area="" asp-controller="Home" asp-action="Index">Duolingo Academy</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                @{ var isLoggedIn = Context.Session.GetInt32("UserProfileId") != null; }
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (isLoggedIn)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Lessons">Lecciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Profile">Perfil</a>
                        </li>
                        <li class="nav-item ms-3">
                            <a class="nav-link btn btn-outline-primary rounded-pill px-3" asp-area="" asp-controller="Home" asp-action="Logout">Cerrar sesión</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-3">
                            <a class="nav-link btn btn-outline-primary rounded-pill px-3" asp-area="" asp-controller="Home" asp-action="Login">Iniciar sesión</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link btn btn-primary rounded-pill px-3 text-white" asp-area="" asp-controller="Home" asp-action="Register">Crear cuenta</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="site-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-section">
        <div class="container text-center">
            &copy; 2026 Duolingo Academy
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
